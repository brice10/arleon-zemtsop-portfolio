# syntax=docker/dockerfile:1
# Image de développement : Node + rien d'autre. Le code et node_modules viennent du
# dossier du projet monté dans /app, l'Angular CLI est celui du projet (npx ng).
FROM node:24-bookworm-slim

ENV NG_CLI_ANALYTICS=false \
    HOME=/tmp \
    npm_config_cache=/tmp/.npm \
    npm_config_update_notifier=false \
    npm_config_fund=false

WORKDIR /app

# --chmod : lisible et exécutable par l'utilisateur non-root du conteneur,
# quels que soient les droits du fichier sur l'hôte.
COPY --chmod=755 docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint

EXPOSE 4200
ENTRYPOINT ["dev-entrypoint"]
CMD ["npx", "ng", "serve"]
